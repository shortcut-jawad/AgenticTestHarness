# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# real k8s secrets (only k8s/secrets.example.yaml, the template, is committed)
/k8s/secrets.yaml

# AWS k3s cluster artifacts (SSH keys, kubeconfig, per-run instance state)
/infra/aws/*.pem
/infra/aws/kubeconfig-*.yaml
/infra/aws/.cluster-state.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local/public sample datasets (do not version)
/public_data/
/tmp-local/

# local agent context
AGENTS.md

# python cache
__pycache__/
*.pyc
